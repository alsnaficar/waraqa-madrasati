SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PROJECT_ID=your-project-id

SUPABASE_PUBLISHABLE_KEY=your_publishable_key

SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Exact Origin allowed to call POST /api/madrasati/pairing/claim (the
# Madrasati browser extension service worker). Format: chrome-extension://<id>.
# The extension id is stable for a published/signed extension; for local dev
# copy it from chrome://extensions. If empty, every origin is rejected
# (fail closed). Never set this to "*".
MADRASATI_EXTENSION_ORIGIN=

# Enable per-IP rate limiting for POST /api/madrasati/pairing/claim. The ONLY
# accepted value is X-Real-IP (Nginx sets it from $remote_addr). Any other
# value - including X-Forwarded-For, which clients can forge - is ignored and
# the endpoint falls back to a shared global bucket. Only enable this when the
# origin port (3000) is NOT reachable directly, so clients cannot bypass Nginx
# and forge X-Real-IP.
MADRASATI_TRUSTED_IP_HEADER=

# Public bank-transfer destination shown to teachers after checkout.
# These are not secrets. Never put provider API keys here or in payment_methods.settings.
BILLING_BANK_NAME=
BILLING_BANK_BENEFICIARY=
BILLING_BANK_IBAN=
